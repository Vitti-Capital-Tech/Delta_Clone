# Copy to .env and fill in. NEVER commit .env or share the service key.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key
# Shared password for the whole app (browser sign-in prompt, any username). REQUIRED when deployed.
APP_PASSWORD=choose-a-long-random-password
PORT=5173
